# ============================================================
#  到点 · 本地配置    ★ 这个文件不进 git，安全存 key ★
#  改完重新构建即可生效： ./gradlew :app:installDebug
# ============================================================

# API 基地址。末尾写到 /v1 为止，不要带 /chat/completions
LLM_BASE_URL=https://api.openai.com/v1

# 你的 API key
LLM_API_KEY=在这里填你的 key

# 模型名
LLM_MODEL=gpt-4o-mini

# ---- 接口风格 ----------------------------------------------
# CHAT_COMPLETIONS : POST /chat/completions —— 事实标准，几乎所有供应商都支持
# RESPONSES        : POST /responses       —— OpenAI 较新的接口，第三方基本不支持
LLM_API_STYLE=CHAT_COMPLETIONS

# ---- 结构化输出档位（见 DESIGN.md §6.2）----------------------
# STRICT_SCHEMA : response_format={type:json_schema, strict:true}  服务端强约束
# JSON_OBJECT   : response_format={type:json_object}               多数国内供应商
# PROMPT_ONLY   : 不传，纯靠提示词约束                              本地小模型/老接口
LLM_JSON_MODE=JSON_OBJECT
