# ============================================================
#  到点 · 本地配置    ★ 这个文件不进 git，安全存 key ★
#  这里只是种子：app 配置页里存过一次之后，以 app 里的为准
#  改完重新构建即可生效： ./gradlew :app:installDebug
# ============================================================

# API 基地址。走 Responses API，末尾写到 /v1 为止，不要带 /responses
LLM_BASE_URL=https://api.openai.com/v1

# 你的 API key
LLM_API_KEY=在这里填你的 key

# 模型名
LLM_MODEL=gpt-4o-mini
