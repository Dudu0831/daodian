<?xml version="1.0" encoding="utf-8"?>
<!-- 一根柱子 + 底下的字。柱子区的高和柱子本身的高由 CardViews 设（setViewLayoutHeight） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical"
    android:paddingStart="3dp"
    android:paddingEnd="3dp">

    <FrameLayout
        android:id="@+id/card_bar_area"
        android:layout_width="match_parent"
        android:layout_height="44dp">

        <ImageView
            android:id="@+id/card_bar_fill"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="bottom"
            android:background="@drawable/card_fill_soft"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/card_bar_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_horizontal"
        android:textSize="9.5sp"
        android:maxLines="1"
        android:textColor="@color/widget_muted" />
</LinearLayout>
