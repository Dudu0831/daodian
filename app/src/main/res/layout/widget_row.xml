<?xml version="1.0" encoding="utf-8"?>
<!--
  一条提醒，一行装完：两三条挤在 3×2 / 4×2 里时一行一条，或者排在大字时钟下面。
  整行点开＝编辑，右边的 ✓＝直接完成。
  高 26dp 和 WidgetRenderer.ROW_DP 对得上：3×2 的内容区只有 83dp，三行得塞得下。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="26dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/row_dot"
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="10dp"
        android:src="@drawable/widget_dot_muted"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="serif"
        android:textSize="13.5sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_ink" />

    <TextView
        android:id="@+id/row_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textSize="11sp"
        android:letterSpacing="0.04"
        android:maxLines="1"
        android:textColor="@color/widget_muted" />

    <FrameLayout
        android:id="@+id/row_done"
        android:layout_width="44dp"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_done">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_widget_check"
            android:importantForAccessibility="no" />
    </FrameLayout>

</LinearLayout>
