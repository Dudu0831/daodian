<?xml version="1.0" encoding="utf-8"?>
<!-- 「下一条」之后的一条，一行装完。整行点开＝编辑，右边的 ✓＝直接完成 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row_root"
    android:layout_width="match_parent"
    android:layout_height="32dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <ImageView
        android:id="@+id/row_dot"
        android:layout_width="5dp"
        android:layout_height="5dp"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="10dp"
        android:src="@drawable/widget_dot_muted"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/row_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="serif"
        android:textSize="13.5sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_ink" />

    <TextView
        android:id="@+id/row_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textSize="11sp"
        android:letterSpacing="0.04"
        android:maxLines="1"
        android:textColor="@color/widget_muted" />

    <FrameLayout
        android:id="@+id/row_done"
        android:layout_width="44dp"
        android:layout_height="match_parent"
        android:contentDescription="@string/widget_done">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_widget_check"
            android:importantForAccessibility="no" />
    </FrameLayout>

</LinearLayout>
