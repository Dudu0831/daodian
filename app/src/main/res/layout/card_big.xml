<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面卡片 · 大数字（2×2）。见 DESIGN.md §8.5
  自上而下：标题 → 一个大数字（前后各一个小字：「过」「天」）→ 脚上一行日期。
  这里写的字是小组件列表里的预览和头一次重画之前的样子，真的由 CardRenderer 填。
  根 id 用 @android:id/background：桌面按它裁系统圆角。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:clipToOutline="true"
    android:background="@drawable/widget_bg"
    android:paddingStart="16dp"
    android:paddingEnd="14dp"
    android:paddingTop="13dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/card_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/card_preview_title"
        android:fontFamily="serif"
        android:textSize="13.5sp"
        android:letterSpacing="0.04"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_ink" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="true"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/card_before"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:textSize="13sp"
            android:visibility="gone"
            android:textColor="@color/widget_muted" />

        <TextView
            android:id="@+id/card_number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/card_preview_number"
            android:fontFamily="serif"
            android:textSize="50sp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/widget_ink" />

        <TextView
            android:id="@+id/card_after"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:text="@string/card_day"
            android:textSize="13sp"
            android:textColor="@color/widget_muted" />
    </LinearLayout>

    <TextView
        android:id="@+id/card_foot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/card_preview_date"
        android:textSize="10.5sp"
        android:letterSpacing="0.08"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_muted" />
</LinearLayout>
