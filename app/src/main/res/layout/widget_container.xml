<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件外壳。见 DESIGN.md §8.2
  RemoteViews 只认白名单里的那几个控件类（LinearLayout / FrameLayout / TextView / ImageView …），
  所以这里没有 ConstraintLayout，分隔线也是 ImageView 而不是 View。

  自上而下：抬头 → 下一条 + 其余几行（或空状态）→ 脚（左边一行小字，右下角一枚墨印）。
  墨印永远在；它旁边不写提示 —— 一枚麦克风自己就说明了。
  根 id 用 @android:id/background：Android 12 起桌面按它裁系统圆角。

  各块高度和 WidgetRenderer 的 CHROME_DP / HERO_DP / ROW_DP 对得上，改一边就得改另一边。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:clipToOutline="true"
    android:background="@drawable/widget_bg"
    android:paddingStart="16dp"
    android:paddingEnd="10dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <!-- 抬头：点下去进提醒列表 -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="26dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingEnd="6dp">

        <TextView
            android:id="@+id/widget_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:fontFamily="serif"
            android:textSize="14sp"
            android:letterSpacing="0.16"
            android:textColor="@color/widget_ink" />

        <TextView
            android:id="@+id/widget_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:gravity="end"
            android:textSize="10.5sp"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_muted" />
    </LinearLayout>

    <!-- 行在 Kotlin 里 addView 进来，不用 ListView：
         没有 RemoteViewsService 就没有跨进程适配器，少一整条会掉链子的链路（决策 8.2） -->
    <LinearLayout
        android:id="@+id/widget_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="4dp" />

    <LinearLayout
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingEnd="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_greeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:textSize="21sp"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:textColor="@color/widget_ink" />
    </LinearLayout>

    <!-- 脚：左边一行小字（下一条是哪天 / 还有几条 / 空状态那句），右下角一枚墨印。
         墨印自己不挂点击：点它落到整块小组件上，整块拉起桌面速记（§8.3）——
         这样桌面随点击给的 sourceBounds 才是整块的框，纸才能从整块里长出来 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_foot"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:textSize="11sp"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_muted" />

        <FrameLayout
            android:id="@+id/widget_mic"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_mic_disc"
            android:contentDescription="@string/widget_mic">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_widget_mic"
                android:importantForAccessibility="no" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
