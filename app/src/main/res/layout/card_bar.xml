<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面卡片 · 墨条（4×1）。见 DESIGN.md §8.5
  标题 + 还剩几天 → 一根从起点走到那天的墨条 → 两头的日期。
  墨条是 ProgressBar（RemoteViews 白名单里有它），颜色在 card_ink.xml 里用 @color，跟着深浅色走。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:clipToOutline="true"
    android:background="@drawable/widget_bg"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="true">

        <TextView
            android:id="@+id/card_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/card_preview_bar_title"
            android:fontFamily="serif"
            android:textSize="13.5sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_ink" />

        <TextView
            android:id="@+id/card_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/card_preview_bar_left"
            android:fontFamily="serif"
            android:textSize="13.5sp"
            android:maxLines="1"
            android:textColor="@color/widget_ink" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/card_ink"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="9dp"
        android:max="100"
        android:progress="87"
        android:progressDrawable="@drawable/card_ink" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/card_start"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/card_preview_bar_start"
            android:textSize="10.5sp"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="@color/widget_muted" />

        <TextView
            android:id="@+id/card_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/card_preview_bar_end"
            android:textSize="10.5sp"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:textColor="@color/widget_muted" />
    </LinearLayout>
</LinearLayout>
