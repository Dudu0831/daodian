<resources>
    <string name="app_name">到点</string>

    <!-- 桌面小组件 -->
    <string name="widget_label">到点 · 说一句就记下</string>
    <string name="widget_description">点右下角的麦克风，说一句话就建好提醒；下一条摆在眼前，点圈完成。</string>
    <!-- 桌面卡片（§8.5）。preview 那几条是小组件列表里的样子 -->
    <string name="card_big_label">到点 · 数日子</string>
    <string name="card_big_description">把一件事钉在桌面上，每天自己数还剩几天。在对话里说「把某件事放到桌面」。</string>
    <string name="card_bar_label">到点 · 墨条</string>
    <string name="card_bar_description">一根从起点走到那天的墨条。在对话里说「把某件事用墨条放到桌面」。</string>
    <string name="card_day">天</string>
    <string name="card_preview_title">牛奶过期</string>
