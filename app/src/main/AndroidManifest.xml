<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 精确闹钟：普通权限，安装即授予。不上架换来的便利，见设计文档 §5.2 -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 唯一需要运行时申请的 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      usesCleartextTraffic: 当前 LLM_BASE_URL 是 http:// 明文。Android 从 API 28 起默认禁止
      明文流量，不开这个连接会被系统直接掐断。
      代价：key 在链路上不加密传输。等 endpoint 换成 https 就该把这行删掉。
      （没有用 networkSecurityConfig 精确放行单个主机，是为了不把服务器地址写进这个会公开的仓库。）
    -->
    <application
        android:name=".DaodianApp"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@android:drawable/ic_lock_idle_alarm"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Daodian">

        <!--
            adjustResize：默认的 adjustPan 会把整个窗口往上推（标题会被推到状态栏外面），
            再叠上 Compose 自己的 ime inset，输入框就被顶高一截。inset 只留 Compose 一个来源。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Daodian">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 到点全屏页（响铃屏），从通知的 fullScreenIntent 拉起，不是 MainActivity。见 §06 -->
        <activity
            android:name=".ui.alarm.AlarmActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.Daodian" />

        <!-- 闹钟到点。只接收我们自己的 PendingIntent，不对外暴露 -->
        <receiver
            android:name=".schedule.AlarmReceiver"
            android:exported="false" />

        <!-- 通知上的「完成」「稍后 10 分钟」 -->
        <receiver
            android:name=".schedule.NotificationActionReceiver"
            android:exported="false" />

        <!--
            桌面小组件。exported 必须是 true —— APPWIDGET_UPDATE 是系统/桌面发过来的。
            另外三条 DATE/TIME/TIMEZONE 也都是受保护广播，别的 app 伪造不了。见 DESIGN.md §8.2
        -->
        <receiver
            android:name=".widget.DaodianWidget"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- 小组件上那个 ✓。只接自己发的 PendingIntent -->
        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />

        <!-- 重排触发源。BOOT_COMPLETED 等都是受保护广播，只有系统能发 -->
        <receiver
            android:name=".schedule.RescheduleReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
